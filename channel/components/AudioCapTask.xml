<?xml version="1.0" encoding="utf-8"?>
<component name="AudioCapTask" extends="Task">
    <!-- The codecs the attached HDMI device takes, read through the platform.
         roDeviceInfo is Task-only, so a screen that wants this answer cannot
         ask the device itself. The result is the codec names the switch would
         offer. -->
    <interface>
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/source/util/CodecProbe.brs" />
    <script type="text/brightscript" uri="pkg:/components/AudioCapTask.brs" />
</component>
